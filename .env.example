# Local: SQLite file. Production (Vercel): the Neon Postgres URL Vercel provides.
DATABASE_URL=file:./alpha.db
# Long random string. Different per environment.
PAYLOAD_SECRET=
# Vercel Blob token for CMS uploads in production. Leave empty locally (files go to /media).
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Used once by `pnpm seed` to create the first admin login.
SEED_ADMIN_PASSWORD=
